<screen>
	<styles>
		<style
			name="style_base"
			flex_main_place="center"
			pad_row="30"
			pad_ver="60"
			pad_bottom="120"
		/>
		<style
			name="style_pad_360"
			pad_ver="36"
			pad_hor="25"
			pad_bottom="100"
		/>
		<style name="style_pad_240" pad_ver="30" pad_hor="20" pad_bottom="80" />
		<style name="style_pad_rect" pad_hor="18" />
		<style name="style_pad_rect_360" pad_hor="14" />
		<style name="style_pad_rect_240" pad_hor="10" />
		<style
			name="style_chart"
			height="100"
			bg_opa="0"
			border_width="0"
			radius="0"
			pad_column="2"
		/>

		<style name="style_arc" width="360" height="360" />
		<style name="style_arc_360" width="300" height="300" arc_width="30" />
		<style name="style_arc_240" width="180" height="180" arc_width="20" />
	</styles>
	<view extends="lv_obj">
		<style name="style_dark" />

		<wd_list bind_screen="sb_screen_size">
			<wd_list-container>
				<style name="style_base" />
				<bind_style
					name="style_pad_360"
					subject="sb_screen_size"
					ref_value="1"
				/>
				<bind_style
					name="style_pad_240"
					subject="sb_screen_size"
					ref_value="2"
				/>
				<bind_state_if_eq
					subject="sb_screen_type"
					ref_value="1"
					state="user_1"
				/>
				<bind_style
					name="style_pad_rect"
					subject="sb_screen_size"
					ref_value="0"
					selector="user_1"
				/>
				<bind_style
					name="style_pad_rect_360"
					subject="sb_screen_size"
					ref_value="1"
					selector="user_1"
				/>
				<bind_style
					name="style_pad_rect_240"
					subject="sb_screen_size"
					ref_value="2"
					selector="user_1"
				/>
				<hs_arc
					style_arc_color="0x18261f"
					align="center"
					bind_value="sb_activity_progress"
					clickable="false"
					style_layout="flex"
					flex_flow="column"
					style_flex_main_place="center"
					style_flex_cross_place="center"
					style_flex_track_place="center"
				>
					<style name="style_arc" />
					<bind_style
						name="style_arc_360"
						subject="sb_screen_size"
						ref_value="1"
					/>
					<bind_style
						name="style_arc_360"
						subject="sb_screen_size"
						ref_value="1"
						selector="indicator"
					/>
					<bind_style
						name="style_arc_240"
						subject="sb_screen_size"
						ref_value="2"
					/>
					<bind_style
						name="style_arc_240"
						subject="sb_screen_size"
						ref_value="2"
						selector="indicator"
					/>
					<hs_text_icon_normal
						icon="icon_steps"
						bind_value="sb_activity_steps"
						bind_fmt="%d"
					/>
					<hs_text_icon_normal
						icon="icon_calories"
						bind_value="sb_activity_kcal"
						bind_fmt="%d"
					/>
				</hs_arc>

				<hs_line />
				<lv_chart
					name="steps_chart"
					type="bar"
					point_count="24"
					hor_div_line_count="0"
					ver_div_line_count="0"
				>
					<style name="style_chart" />
					<lv_chart-axis
						axis="primary_y"
						min_value="0"
						max_value="100"
					/>
					<lv_chart-series
						color="0xffffff"
						axis="primary_y"
						values="60 43 34 24 38 54 54 20 45 0 25 56 80 34 65 45 56 50 35 15 34 65 25 56"
					/>
				</lv_chart>
				<hs_line />
			</wd_list-container>
		</wd_list>

		<hs_text_small
			align="bottom_mid"
			bind_text="sb_time_string"
			style_text_color="0x6d6d6d"
			style_pad_bottom="6"
		/>
	</view>
</screen>
