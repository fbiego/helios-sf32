<screen>
	<styles>
		<style name="style_base" width="100%" height="100%" />
		<style name="style_cont" pad_ver="80" pad_row="40" pad_hor="10" />
		<style name="style_cont_360" pad_ver="60" pad_row="30" pad_hor="18" />
		<style name="style_cont_240" pad_ver="40" pad_row="20" pad_hor="12" />
	</styles>

	<view>
		<style name="style_dark" />
		<style name="style_base" />

		<hs_column
			height="100%"
			style_flex_cross_place="center"
			style_flex_track_place="center"
		>
			<style name="style_cont" />
			<bind_style
				name="style_cont_360"
				subject="sb_screen_size"
				ref_value="1"
			/>
			<bind_style
				name="style_cont_240"
				subject="sb_screen_size"
				ref_value="2"
			/>

			<wd_image
				clickable="false"
				src="img_call"
				scale_0="256"
				scale_1="190"
				scale_2="120"
				size_1="55"
				size_2="30"
				bind_scale="sb_screen_size"
			/>

			<hs_text_small translation_tag="incoming_call" />
			<hs_text_normal
				width="80%"
				style_text_align="center"
				bind_text="sb_caller_name"
			/>
		</hs_column>
		<hs_text_small
			align="bottom_mid"
			bind_text="sb_time_string"
			style_text_color="0x6d6d6d"
			style_pad_bottom="6"
		/>
	</view>
</screen>
