<screen>
	<view extends="lv_obj">
		<style name="style_dark" />

		<hs_column align="center" style_flex_track_place="center" style_flex_cross_place="center" style_pad_row="30">
			<wd_image src="img_finger_sensor" style_image_recolor="0xffffff" style_image_recolor_opa="255">
				<bind_flag_if_eq subject="sb_health_finger_detect" flag="hidden" ref_value="1" />
			</wd_image>
			<hs_text_small text="Place finger on the sensor">
				<bind_flag_if_eq subject="sb_health_finger_detect" flag="hidden" ref_value="1" />
			</hs_text_small>
			<hs_text_icon_normal width="75%" icon="img_heart_beat" bind_value="sb_health_bpm" bind_fmt="  %d BPM">
				<bind_flag_if_eq subject="sb_health_finger_detect" flag="hidden" ref_value="0" />
			</hs_text_icon_normal>

			<hs_text_icon_normal
				width="75%"
				icon="img_blood_oxygen"
				bind_value="sb_health_oxygen"
				bind_fmt="SP02: %d%%"
			>
				<bind_flag_if_eq subject="sb_health_finger_detect" flag="hidden" ref_value="0" />
			</hs_text_icon_normal>
		</hs_column>
	</view>
</screen>
