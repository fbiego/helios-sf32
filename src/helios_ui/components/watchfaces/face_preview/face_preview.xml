<component>
	<previews>
		<preview width="360" height="440" style_bg_color="0x060606" />
	</previews>

	<api>
		<!-- Add your API here here. For example 
		<prop name="prop1" type="int" default="0" help="What is this property?"/>
		-->
		<prop name="image" type="image" default="img_face_preview" />
		<prop name="label" type="string" default="Default" />
	</api>

	<styles>
		<style
			name="style_base"
			width="75%"
			height="100%"
			layout="flex"
			flex_flow="column"
			flex_cross_place="center"
			flex_main_place="center"
			flex_track_place="center"
			pad_row="10"
		/>
	</styles>

	<view extends="lv_obj" scrollable="false">
		<remove_style_all />
		<style name="style_base" />
		<lv_image src="$image" />
		<hs_text_normal text="$label" />
	</view>
</component>
