<component>
	<previews>
		<preview
			width="466"
			height="466"
			style_radius="233"
			style_bg_color="0x000"
		/>
		<preview
			width="360"
			height="360"
			style_radius="180"
			style_bg_color="0x000"
		/>
		<preview
			width="240"
			height="240"
			style_radius="120"
			style_bg_color="0x000"
		/>
		<preview
			width="410"
			height="502"
			style_radius="100"
			style_bg_color="0x000"
		/>
		<preview
			width="390"
			height="450"
			style_radius="80"
			style_bg_color="0x000"
		/>
		<preview
			width="240"
			height="280"
			style_radius="60"
			style_bg_color="0x000"
		/>
	</previews>

	<styles>
		<style
			name="style_base"
			width="100%"
			height="100%"
			pad_ver="12"
			pad_hor="20"
			pad_row="10"
			bg_color="0x000000"
			bg_opa="255"
			layout="flex"
			flex_flow="column"
			flex_track_place="center"
			flex_cross_place="center"
		/>
		<style name="style_pad_360" pad_ver="10" pad_hor="20" pad_row="6" />
		<style name="style_pad_240" pad_ver="8" pad_hor="10" pad_row="2" />
		<style name="style_pad_rect" pad_hor="4" />
		<style name="style_pad_rect_360" pad_hor="14" />
		<style name="style_pad_rect_240" pad_hor="0" />
	</styles>

	<view extends="lv_obj">
		<remove_style_all />
		<style name="style_base" />
		<bind_style
			name="style_pad_360"
			subject="sb_screen_size"
			ref_value="1"
		/>
		<bind_style
			name="style_pad_240"
			subject="sb_screen_size"
			ref_value="2"
		/>
		<bind_state_if_eq
			subject="sb_screen_type"
			ref_value="1"
			state="user_1"
		/>
		<bind_style
			name="style_pad_rect"
			subject="sb_screen_size"
			ref_value="0"
			selector="user_1"
		/>
		<bind_style
			name="style_pad_rect_360"
			subject="sb_screen_size"
			ref_value="1"
			selector="user_1"
		/>
		<bind_style
			name="style_pad_rect_240"
			subject="sb_screen_size"
			ref_value="2"
			selector="user_1"
		/>

		<wd_image
			name="icon"
			clickable="false"
			src="icon_nt_wechat"
			scale_0="256"
			scale_1="190"
			scale_2="120"
			size_1="55"
			size_2="30"
			bind_scale="sb_screen_size"
		/>

		<hs_text_normal
			name="title"
			width="80%"
			style_text_align="center"
			long_mode="scroll_circular"
			text="Lorem ipsum"
		/>

		<hs_container width="90%" flex_grow="1" style_pad_bottom="60">
			<hs_text_small
				name="message"
				width="100%"
				text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum."
			/>
		</hs_container>

		<hs_text_small name="time" text="13:45" style_text_color="0x8d8d8d" />
	</view>
</component>
