<component>
	<previews>
		<preview width="400" style_bg_color="0x000" />
		<preview width="300" style_bg_color="0x000" />
		<preview width="200" style_bg_color="0x000" />
	</previews>

	<styles>
		<style
			name="style_base"
			width="100%"
			height="content"
			radius="100"
			pad_all="10"
			pad_bottom="3"
			pad_hor="25"
			bg_color="0x171717"
			bg_opa="255"
		/>

		<style name="style_pad_360" pad_all="8" pad_bottom="2" pad_hor="20" />
		<style name="style_pad_240" pad_all="6" pad_bottom="1" pad_hor="14" />
	</styles>
	<api>
		<prop name="tag" type="string" default="Title" />
	</api>

	<view extends="lv_obj" clickable="false">
		<remove_style_all />
		<style name="style_base" />
		<bind_style name="style_pad_360" subject="sb_screen_size" ref_value="1" />
		<bind_style name="style_pad_240" subject="sb_screen_size" ref_value="2" />
		<hs_text_normal translation_tag="$tag" long_mode="scroll_circular" align="center" />

		<event_cb callback="on_hs_title_pill_cb" trigger="all" />
	</view>
</component>
