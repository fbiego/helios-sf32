<component>
	<previews>
		<preview width="400" style_bg_color="0x000" />
		<preview width="300" style_bg_color="0x000" />
		<preview width="200" style_bg_color="0x000" />
	</previews>

	<api>
		<prop name="text" type="string" default="Text" />
		<prop name="tag" type="string" default="" />
	</api>

	<styles>
		<style
			name="style_base"
			width="100%"
			bg_color="0x3a3a3a"
			bg_opa="0"
			height="46"
			text_color="0xffffff"
			border_width="0"
			radius="6"
			pad_all="0"
			pad_top="5"
			pad_hor="10"
		/>
		<style name="style_dropdown_360" height="36" radius="4" pad_top="3" pad_hor="8" />
		<style name="style_dropdown_240" height="24" radius="2" pad_top="3" pad_hor="5" />
		<style name="style_pressed" bg_color="0x989898" bg_opa="255" text_color="0x000" />
		<style name="style_checked" bg_color="#color_primary" bg_opa="255" />
	</styles>

	<view extends="lv_obj" scrollable="false">
		<!-- Add widgets/components here -->
		<style name="style_base" />
		<bind_style name="style_dropdown_360" subject="sb_screen_size" ref_value="1" />
		<bind_style name="style_dropdown_240" subject="sb_screen_size" ref_value="2" />

		<style name="style_checked" selector="checked" />
		<style name="style_pressed" selector="pressed" />

		<hs_text_small text="$text" translation_tag="$tag" align="center" width="100%" />
	</view>
</component>
