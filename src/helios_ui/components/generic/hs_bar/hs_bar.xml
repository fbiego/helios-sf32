<component>
	<previews>
		<preview width="400" style_bg_color="0x000" />
		<preview width="300" style_bg_color="0x000" />
		<preview width="200" style_bg_color="0x000" />
	</previews>

	<api>
		<prop name="label" type="string" default="Brightness" />
		<prop name="tag" type="string" default="" />
		<prop name="bind_value" type="subject" default="sb_battery_percent" />
	</api>

	<styles>
		<style
			name="style_base"
			width="100%"
			height="content"
			layout="flex"
			flex_flow="column"
			text_color="0xfff"
			radius="10"
			pad_ver="0"
			pad_row="10"
			bg_color="0x171717"
			bg_opa="25"
		/>
		<style name="style_base_360" pad_row="6" />
		<style name="style_base_240" pad_row="4" />
		<style
			name="style_bar"
			width="100%"
			bg_color="0x494949"
			height="46"
			text_color="0xfff"
			border_width="1"
			border_color="0xfff"
		/>
		<style name="style_bar_360" height="36" />
		<style name="style_bar_240" height="24" />
		<style name="style_indicator" bg_color="0xffffff" bg_opa="255" />
	</styles>

	<view extends="lv_obj">
		<remove_style_all />
		<style name="style_base" />
		<bind_style name="style_base_360" subject="sb_screen_size" ref_value="1" />
		<bind_style name="style_base_240" subject="sb_screen_size" ref_value="2" />
		<hs_text_normal width="100%" text="$label" translation_tag="$tag" />

		<lv_bar bind_value="$bind_value">
			<style name="style_bar" />
			<bind_style name="style_bar_360" subject="sb_screen_size" ref_value="1" />
			<bind_style name="style_bar_240" subject="sb_screen_size" ref_value="2" />
			<style name="style_indicator" selector="indicator" />
			<lv_label
				bind_text="$bind_value"
				bind_text-fmt="%d%%"
				align="left_mid"
				x="15"
				style_blend_mode="difference"
			>
				<bind_style name="style_text_small_466" subject="sb_screen_size" ref_value="0" />
				<bind_style name="style_text_small_360" subject="sb_screen_size" ref_value="1" />
				<bind_style name="style_text_small_240" subject="sb_screen_size" ref_value="2" />
			</lv_label>
		</lv_bar>
	</view>
</component>
