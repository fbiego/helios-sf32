<component>
	<previews>
		<preview width="400" style_bg_color="0x000" />
		<preview width="300" style_bg_color="0x000" />
		<preview width="200" style_bg_color="0x000" />
	</previews>

	<api>
		<prop name="label" type="string" default="Circular Scroll" />
		<prop name="tag" type="string" default="" />
		<prop name="text_color" type="color" default="#color_primary" />
	</api>

	<styles>
		<style
			name="style_base"
			width="100%"
			height="content"
			bg_color="0x191919"
			radius="10"
			pad_all="10"
			bg_opa="255"
		/>
		<style name="style_base_360" pad_all="6" radius="8" />
		<style name="style_base_240" pad_all="4" radius="6" />
		<style name="style_pressed" bg_color="0xbcbcbc" bg_opa="155" />
		<style name="style_checked" bg_color="0xf9f7f7" bg_opa="155" />
		<style name="style_checked_text" blend_mode="difference" />
	</styles>

	<view extends="lv_obj" state_trickle="true">
		<remove_style_all />
		<style name="style_base" />
		<bind_style name="style_base_360" subject="sb_screen_size" ref_value="1" />
		<bind_style name="style_base_240" subject="sb_screen_size" ref_value="2" />
		<style name="style_pressed" selector="pressed" />
		<style name="style_checked" selector="checked" />

		<hs_text_normal
			text="$label"
			translation_tag="$tag"
			width="100%"
			style_pad_top="5"
			style_text_color="$text_color"
			style_text_align="center"
		>
			<style name="style_checked_text" selector="checked" />
		</hs_text_normal>
	</view>
</component>
