<component>
	<previews>
		<preview width="400" style_bg_color="0x000" />
		<preview width="300" style_bg_color="0x000" />
		<preview width="200" style_bg_color="0x000" />
	</previews>
	<styles>
		<style
			name="style_group"
			width="360"
			height="content"
			radius="55"
			layout="flex"
			flex_flow="row_wrap"
			pad_row="15"
			pad_column="15"
		/>
		<style name="style_group_360" width="290" pad_row="10" pad_column="10" />
		<style name="style_group_240" width="200" pad_row="10" pad_column="10" />
	</styles>
	<view event_bubble="true">
		<remove_style_all />
		<style name="style_group" />
		<bind_style name="style_group_360" subject="sb_screen_size" ref_value="1" />
		<bind_style name="style_group_240" subject="sb_screen_size" ref_value="2" />
	</view>
</component>
