<component>
	<previews>
		<preview width="400" style_bg_color="0x000" />
		<preview width="300" style_bg_color="0x000" />
		<preview width="200" style_bg_color="0x000" />
	</previews>
	<styles>
		<style name="style_button" width="110" height="110" radius="55" bg_color="0x282828" bg_opa="255" />
		<style name="style_button_360" width="90" height="90" />
		<style name="style_button_240" width="60" height="60" />
		<style name="style_pressed" bg_color="0x0534ff" />
		<style name="style_icon" align="center" image_recolor="0xffffff" image_recolor_opa="255" />
		<style name="style_disabled" bg_color="0x3d3c38" />
	</styles>
	<api>
		<prop name="icon" type="image" default="icon_wifi" />
	</api>
	<view scrollable="false" event_bubble="true">
		<remove_style_all />
		<style name="style_button" />
		<style name="style_pressed" selector="pressed" />
		<style name="style_disabled" selector="disabled" />

		<bind_style name="style_button_360" subject="sb_screen_size" ref_value="1" />
		<bind_style name="style_button_240" subject="sb_screen_size" ref_value="2" />
		<wd_image
			clickable="false"
			align="center"
			src="$icon"
			scale_0="256"
			scale_1="190"
			scale_2="130"
			size_1="60"
			size_2="40"
			bind_scale="sb_screen_size"
			style_image_recolor="0xffffff"
			style_image_recolor_opa="255"
		/>
	</view>
</component>
