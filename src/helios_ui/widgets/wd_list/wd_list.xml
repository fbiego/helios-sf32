<widget>
	<previews>
		<preview width="466" height="466" style_bg_color="0x000000" />
		<preview width="360" height="360" style_bg_color="0x000000" />
		<preview width="240" height="240" style_bg_color="0x000000" />
	</previews>

	<api>
		<prop name="bind_mode" type="subject" help="Subject that changes between list and grid mode" />
		<prop name="bind_circular" type="subject" help="Subject that enables circular scroll in list mode" />
		<prop name="bind_screen" type="subject" help="Subject that enables circular scroll in list mode" />
		<prop name="center_lock" type="bool" help="Center prevents scrolling in order to detect gesture" />
		<element name="container" access="get" type="lv_obj" />
		<element name="title" access="get" type="lv_obj" />
	</api>

	<styles>
		<style
			name="style_cont"
			width="100%"
			height="100%"
			align="center"
			border_width="0"
			pad_top="100"
			pad_bottom="150"
			pad_hor="33"
		/>
		<style name="style_title" width="100%" height="content" />
		<style name="style_flex" layout="flex" flex_flow="row_wrap" pad_column="15" pad_row="10" />
		<style name="style_pad_grid" pad_hor="53" pad_row="15" />
	</styles>

	<view extends="lv_obj" width="100%" height="100%">
		<lv_obj name="list">
			<remove_style_all />
			<style name="style_cont" />
			<style name="style_flex" />
		</lv_obj>
		<lv_obj name="title" clickable="false">
			<remove_style_all />
			<style name="style_title" />
		</lv_obj>
	</view>
</widget>
